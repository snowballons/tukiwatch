.success) {\n        throw new Error(data.error || 'Conversion failed');\n      }\n\n      // Success!\n      Alert.alert(\n        'Success!',\n        'Your account has been converted. Check your email to verify your address.',\n        [\n          {\n            text: 'OK',\n            onPress: () => navigation.goBack()\n          }\n        ]\n      );\n    } catch (error: any) {\n      console.error('Conversion error:', error);\n      Alert.alert(\n        'Error',\n        error.message || 'Failed to convert account. Please try again.'\n      );\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <View style={styles.container}>\n      <KeyboardAvoidingView\n        behavior={Platform.OS === 'ios' ? 'padding' : 'height'}\n        style={styles.keyboardView}\n      >\n        <ScrollView contentContainerStyle={styles.scrollContent}>\n          <TouchableOpacity style={styles.backBtn} onPress={() => navigation.goBack()}>\n            <ArrowLeft color={Palette.text} size={24} />\n          </TouchableOpacity>\n\n          <View style={styles.header}>\n            <View style={styles.iconContainer}>\n              <UserPlus color={Palette.primary} size={48} />\n            </View>\n            <Text style={styles.title}>Convert to Permanent Account</Text>\n            <Text style={styles.subtitle}>\n              Keep all your favorites by creating a permanent account. Your data will be preserved.\n            </Text>\n          </View>\n\n          <View style={styles.form}>\n            <Text style={styles.label}>Username</Text>\n            <TextInput\n              style={styles.input}\n              placeholder=\"Choose a username\"\n              placeholderTextColor={Palette.textMuted}\n              value={username}\n              onChangeText={setUsername}\n              autoCapitalize=\"none\"\n              autoCorrect={false}\n            />\n\n            <Text style={styles.label}>Email</Text>\n            <TextInput\n              style={styles.input}\n              placeholder=\"your@email.com\"\n              placeholderTextColor={Palette.textMuted}\n              value={email}\n              onChangeText={setEmail}\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoCorrect={false}\n            />\n\n            <Text style={styles.label}>Password</Text>\n            <TextInput\n              style={styles.input}\n              placeholder=\"At least 6 characters\"\n              placeholderTextColor={Palette.textMuted}\n              value={password}\n              onChangeText={setPassword}\n              secureTextEntry\n            />\n\n            <Text style={styles.label}>Confirm Password</Text>\n            <TextInput\n              style={styles.input}\n              placeholder=\"Re-enter password\"\n              placeholderTextColor={Palette.textMuted}\n              value={confirmPassword}\n              onChangeText={setConfirmPassword}\n              secureTextEntry\n            />\n\n            <TouchableOpacity\n              style={[styles.convertBtn, { opacity: username && email && password && confirmPassword ? 1 : 0.5 }]}\n              onPress={handleConvert}\n              disabled={loading || !username || !email || !password || !confirmPassword}\n            >\n              {loading ? (\n                <ActivityIndicator color=\"#fff\" />\n              ) : (\n                <>\n                  <UserPlus color=\"#fff\" size={20} />\n                  <Text style={styles.btnText}>Convert Account</Text>\n                </>\n              )}\n            </TouchableOpacity>\n\n            <View style={styles.infoBox}>\n              <Text style={styles.infoText}>\n                ✓ All your favorites will be preserved{'\\n'}\n                ✓ You'll receive a verification email{'\\n'}\n                ✓ You can sign in from any device\n              </Text>\n            </View>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: Palette.background,\n  },\n  keyboardView: {\n    flex: 1,\n  },\n  scrollContent: {\n    paddingHorizontal: Spacing.lg,\n    paddingTop: 60,\n    paddingBottom: 40,\n  },\n  backBtn: {\n    marginBottom: Spacing.lg,\n  },\n  header: {\n    alignItems: 'center',\n    marginBottom: Spacing.xl,\n  },\n  iconContainer: {\n    width: 80,\n    height: 80,\n    borderRadius: 40,\n    backgroundColor: Palette.primary + '20',\n    justifyContent: 'center',\n    alignItems: 'center',\n    marginBottom: Spacing.md,\n  },\n  title: {\n    color: Palette.text,\n    fontSize: 28,\n    fontWeight: 'bold',\n    textAlign: 'center',\n    marginBottom: Spacing.sm,\n  },\n  subtitle: {\n    color: Palette.textMuted,\n    fontSize: 15,\n    textAlign: 'center',\n    lineHeight: 22,\n  },\n  form: {\n    width: '100%',\n  },\n  label: {\n    color: Palette.text,\n    fontSize: 14,\n    fontWeight: '600',\n    marginBottom: Spacing.sm,\n    marginTop: Spacing.md,\n  },\n  input: {\n    backgroundColor: Palette.card,\n    height: 56,\n    borderRadius: 12,\n    paddingHorizontal: 16,\n    color: Palette.text,\n    borderWidth: 1,\n    borderColor: Palette.border,\n    fontSize: 16,\n  },\n  convertBtn: {\n    backgroundColor: Palette.primary,\n    height: 56,\n    borderRadius: 16,\n    flexDirection: 'row',\n    justifyContent: 'center',\n    alignItems: 'center',\n    marginTop: Spacing.xl,\n    gap: 8,\n  },\n  btnText: {\n    color: '#fff',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  infoBox: {\n    backgroundColor: Palette.card,\n    borderRadius: 12,\n    padding: Spacing.md,\n    marginTop: Spacing.lg,\n    borderWidth: 1,\n    borderColor: Palette.primary + '40',\n  },\n  infoText: {\n    color: Palette.textMuted,\n    fontSize: 14,\n    lineHeight: 22,\n  },\n});\n",
