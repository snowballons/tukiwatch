{
  "cli": {
    "version": ">= 16.28.0"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production-arm64": {
      "extends": "production",
      "env": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    "production-universal": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
