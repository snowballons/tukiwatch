# TukiWatch app — environment configuration
# Copy to .env and fill in your own values.

# Base URL of your self-hosted TukiWatch API (see ../api).
# This is the DEFAULT the app connects to. It can be overridden at runtime
# from Settings → Backend → Scan QR Code, so users of a published build do not
# need to rebuild the app to use their own backend.
EXPO_PUBLIC_API_URL=http://localhost:8000/

# API key required by the backend for every request (X-API-Key header).
# Must match API_KEY in the backend's .env.
EXPO_PUBLIC_BACKEND_API_KEY=

# URL of the update manifest (version.json) used by "Check for Updates".
# Optional — falls back to https://downloads.snowballons.com/version.json
# EXPO_PUBLIC_UPDATE_MANIFEST_URL=