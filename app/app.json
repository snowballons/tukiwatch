{
  "expo": {
    "name": "TukiWatch",
    "slug": "streamwatch",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "tukiwatch",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A0A0A"
      },
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "package": "com.tukiwatch.app"
    },
    "plugins": [
      "expo-video",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "manifestQueries": {
              "intent": [
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "twitch"
                  }
                },
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "vnd.youtube"
                  }
                },
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "instagram"
                  }
                },
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "fb"
                  }
                },
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "tiktok"
                  }
                },
                {
                  "action": "VIEW",
                  "category": [
                    "BROWSABLE"
                  ],
                  "data": {
                    "scheme": "vk"
                  }
                }
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2879c1fe-24f0-415e-b606-b5ab7888d48b"
      }
    },
    "owner": "lunderwood1967s-organization",
    "ios": {
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "tukiwatch"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "twitch",
          "youtube",
          "vnd.youtube",
          "instagram",
          "fb",
          "tiktok",
          "vk"
        ]
      }
    }
  }
}
