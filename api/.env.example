# TukiWatch API — environment configuration
# Copy to .env and fill in your own values.
# Comma-separated list of allowed CORS origins. "*" allows all.
ALLOWED_ORIGINS=*
# Twitch Helix API for Discovery (required for Discovery feature)
# Register an app at https://dev.twitch.tv/console to get these
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# Twitch OAuth token (optional) — enables ad-free Twitch streams (Twitch Turbo).
# TWITCH_OAUTH_TOKEN=
# Redis (optional — omit to fall back to the in-memory cache).
# Redis is an ephemeral cache only; no data lives here permanently.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# For the hosted Railway deployment, replace the wildcard above with your real
# origins (e.g. ALLOWED_ORIGINS=https://tukiwatch.snowballons.com).
