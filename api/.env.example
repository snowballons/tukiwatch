# TukiWatch API — environment configuration
# Copy to .env and fill in your own values.

# API key required by clients for every request (X-API-Key header).
# Set to a long random string; the mobile app uses this as EXPO_PUBLIC_BACKEND_API_KEY.
API_KEY=

# Comma-separated list of allowed CORS origins. "*" allows all.
ALLOWED_ORIGINS=*

# Twitch OAuth token (optional) — enables ad-free Twitch streams (Twitch Turbo).
# TWITCH_OAUTH_TOKEN=

# Redis (optional — omit to fall back to the in-memory cache).
# Redis is an ephemeral cache only; no data lives here permanently.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=