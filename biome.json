{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "app/**/*.{ts,tsx,js,jsx}",
      "api/**/*.{py}",
      "!**/node_modules",
      "!**/.venv",
      "!**/__pycache__",
      "!**/dist",
      "!**/build",
      "!**/.expo"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  }
}
